<%- include('admin-start') %>
<section class="admin-summary-grid"><div class="admin-stat"><div class="admin-stat-label">使用者總數</div><div class="admin-stat-value"><%= summary.totalUsers %></div><div class="admin-stat-note">目前已建立帳號</div></div><div class="admin-stat"><div class="admin-stat-label">血壓記錄總數</div><div class="admin-stat-value"><%= summary.totalRecords.toLocaleString('zh-HK') %></div><div class="admin-stat-note">所有使用者合計</div></div><div class="admin-stat"><div class="admin-stat-label">今日新增記錄</div><div class="admin-stat-value"><%= summary.todayRecords.toLocaleString('zh-HK') %></div><div class="admin-stat-note">以伺服器日期計算</div></div></section>
<div class="admin-grid"><section class="admin-panel"><div class="admin-panel-head"><div><h2>管理捷徑</h2><p>前往常用管理頁面。</p></div></div><div class="admin-tool"><strong>使用者管理</strong><span>新增家庭成員、調整名稱和識別色。</span><a class="btn btn-primary" href="/admin/users">管理使用者</a></div><div class="admin-tool"><strong>血壓記錄</strong><span>查看近期量測與使用者分布。</span><a class="btn btn-primary" href="/admin/records">查看記錄</a></div></section><section class="admin-panel"><h2>資料備份</h2><p>匯出完整 SQL 備份，或前往還原頁匯入記錄。</p><div class="admin-tool"><a class="btn btn-primary" href="/admin/backup">開啟備份還原</a></div></section></div>
<%- include('admin-end') %>
