<%- include('admin-start') %>
<div class="admin-panel admin-alert-panel"><div class="admin-panel-head"><div><h2>近期需要留意</h2><p>近 7 日異常量測，僅供追蹤。</p></div><a href="/admin/activity" class="btn-sm btn-sm-edit">系統與資料狀態</a></div><% if (!overview.alerts.length) { %><p>最近 7 日尚未有偏高或偏低記錄。</p><% } %><% overview.alerts.forEach(function(alert) { %><a class="admin-alert-row" href="/admin/records?<%= new URLSearchParams({user: alert.userId || '', status: alert.status, from: alert.day, to: alert.day}).toString() %>"><span><strong><%= alert.userName %></strong> · <%= alert.high %>/<%= alert.low %> mmHg</span><span class="admin-status rate-<%= alert.status %>"><%= alert.status === 'high' ? '偏高' : '偏低' %></span><time><%= new Date(alert.recordedAt).toLocaleString('zh-HK') %></time></a><% }); %><% if (overview.userRates.length) { %><p>近期偏高比例（按量測筆數）：<% overview.userRates.forEach(function(user, index) { %><%= index ? '、' : '' %><a href="/admin/records?user=<%= user.userId || '' %>&status=high"><%= user.userName %> <%= user.highRate %>%（<%= user.high %>/<%= user.total %> 筆）</a><% }); %></p><% } %><% const inactive = overviewUsers.filter(function(user) { return (!overviewUserId || String(user.id) === overviewUserId) && (!user.last_recorded_at || Date.now() - new Date(user.last_recorded_at).getTime() > 7 * 86400000); }); %><% if (inactive.length) { %><p>超過 7 日未量測／尚未量測：<% inactive.forEach(function(user, index) { %><%= index ? '、' : '' %><a href="/admin/records?user=<%= user.id %>"><%= user.name %></a><% }); %></p><% } %></div>
<section class="admin-dashboard-section"><div class="admin-section-head"><div><h2>整體概況</h2></div></div><div class="admin-summary-grid"><div class="admin-stat"><div class="admin-stat-label">使用者總數</div><div class="admin-stat-value"><%= summary.totalUsers %></div><div class="admin-stat-note">目前已建立帳號</div></div><div class="admin-stat"><div class="admin-stat-label">血壓記錄總數</div><div class="admin-stat-value"><%= summary.totalRecords.toLocaleString('zh-HK') %></div><div class="admin-stat-note">所有使用者合計</div></div><div class="admin-stat"><div class="admin-stat-label">今日新增記錄</div><div class="admin-stat-value"><%= summary.todayRecords.toLocaleString('zh-HK') %></div><div class="admin-stat-note">以伺服器日期計算</div></div></div></section>
<section class="admin-dashboard-section"><div class="admin-section-head"><div><h2>近期健康概覽</h2></div><form class="admin-overview-filter" method="get" action="/admin"><label for="overviewUser">統計使用者</label><select id="overviewUser" name="overviewUser" onchange="this.form.submit()"><option value="">所有使用者</option><% overviewUsers.forEach(function(user) { %><option value="<%= user.id %>" <%= overviewUserId === String(user.id) ? 'selected' : '' %>><%= user.name %></option><% }); %></select><noscript><button type="submit" class="btn-sm btn-sm-edit">套用</button></noscript></form></div><div class="admin-overview-grid">
<div class="admin-panel"><h2>最近量測</h2><% if (overview.latest) { %><div class="admin-latest-value"><strong><%= overview.latest.high %>/<%= overview.latest.low %></strong><span>mmHg</span></div><p><%= overview.latest.userName %> · 心跳 <%= overview.latest.heart %> bpm</p><p class="admin-muted"><%= new Date(overview.latest.recordedAt).toLocaleString('zh-HK') %></p><% } else { %><div class="admin-empty">尚未有量測記錄</div><% } %></div>
<div class="admin-panel"><h2>最近 7 日</h2><div class="admin-rate-row"><span class="rate-normal">正常 <strong><%= overview.sevenDay.normalRate %>%</strong></span><span class="rate-high">偏高 <strong><%= overview.sevenDay.highRate %>%</strong></span><span class="rate-low">偏低 <strong><%= overview.sevenDay.lowRate %>%</strong></span></div><p><%= overviewUserId ? '此使用者' : '所有使用者' %>合共 <%= overview.sevenDay.total %> 筆量測</p></div>
<div class="admin-panel"><h2>資料保護</h2><p><%= lastBackupAt ? '最近產生備份：' + new Date(lastBackupAt).toLocaleString('zh-HK') : '尚未有備份匯出紀錄' %></p><div class="admin-tool"><a class="btn btn-primary" href="/admin/backup">備份與還原</a></div></div>
</div></section>
<section class="admin-dashboard-section"><div class="admin-section-head"><div><h2>管理工具</h2></div></div><div class="admin-grid"><section class="admin-panel"><div class="admin-panel-head"><div><h2>管理捷徑</h2></div></div><div class="admin-tool"><strong>使用者管理</strong><a class="btn btn-primary" href="/admin/users">管理使用者</a></div><div class="admin-tool"><strong>血壓記錄</strong><a class="btn btn-primary" href="/admin/records">查看記錄</a></div></section><section class="admin-panel"><h2>資料備份</h2><div class="admin-tool"><a class="btn btn-primary" href="/admin/backup">開啟備份還原</a></div></section></div></section>
<%- include('admin-end') %>
