<%- include('admin-start') %>
<section class="admin-panel"><div class="admin-panel-head"><div><h2>使用者列表</h2><p>共 <%= users.length %> 位使用者，可搜尋、編輯或刪除。</p></div><input id="userSearch" class="admin-search" type="search" placeholder="搜尋使用者" aria-label="搜尋使用者" aria-controls="userTableBody"></div><div id="userSearchSummary" class="admin-filter-summary" role="status"><%= users.length %> 位使用者</div><div class="admin-table-wrap"><table class="admin-user-table"><thead><tr><th>使用者</th><th>記錄數</th><th>最近量測</th><th>操作</th></tr></thead><tbody id="userTableBody"><% users.forEach(function(u) { %><tr data-user-name="<%= u.name.toLowerCase() %>"><td><div class="admin-user"><div class="mini-avatar" style="background:<%= u.color %>"><%= u.name.charAt(0) %></div><div><div class="admin-user-name"><%= u.name %></div><div class="admin-user-id">ID #<%= u.id %></div></div></div></td><td><%= Number(u.record_count || 0).toLocaleString('zh-HK') %> 筆</td><td class="admin-muted"><%= u.last_recorded_at ? new Date(u.last_recorded_at).toLocaleString('zh-HK',{month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'}) : '尚未有記錄' %></td><td><div class="admin-actions"><button type="button" class="btn-sm btn-sm-edit" data-action="edit-user" data-id="<%= u.id %>" data-name="<%= u.name %>" data-color="<%= u.color %>">編輯</button><button type="button" class="btn-sm btn-sm-delete" data-action="delete-user" data-id="<%= u.id %>" data-name="<%= u.name %>">刪除</button></div></td></tr><% }); %></tbody></table><div id="userSearchEmpty" class="admin-empty" hidden>沒有符合的使用者</div><% if (!users.length) { %><div class="admin-empty">尚未建立使用者</div><% } %></div></section>
<section class="admin-panel"><div class="admin-panel-head"><div><h2>新增使用者</h2><p>建立新的家庭成員或照護對象。</p></div></div><form id="addForm" class="admin-add-form"><div><label for="newName">姓名</label><input type="text" id="newName" required maxlength="50" placeholder="例如：王先生"></div><div><label for="newColor">識別色</label><input type="color" id="newColor" value="#4CAF50"></div><button type="submit" class="btn btn-primary">新增使用者</button></form></section>
<div class="modal-overlay" id="editModal"><div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="editTitle"><h2 id="editTitle">編輯使用者</h2><input type="hidden" id="editId"><p><label for="editName">姓名</label></p><input type="text" id="editName" maxlength="50"><p><label for="editColor">識別色</label></p><input type="color" id="editColor"><div class="modal-actions"><button type="button" class="btn btn-primary" id="saveEdit">儲存</button><button type="button" class="btn btn-back" id="closeEdit">取消</button></div></div></div>
<%- include('admin-end') %>
