<%- include('admin-start') %>
<section class="admin-summary-grid"><div class="admin-stat"><div class="admin-stat-label">全部記錄</div><div class="admin-stat-value"><%= summary.totalRecords.toLocaleString('zh-HK') %></div><div class="admin-stat-note">資料庫累計</div></div><div class="admin-stat"><div class="admin-stat-label">今日記錄</div><div class="admin-stat-value"><%= summary.todayRecords.toLocaleString('zh-HK') %></div><div class="admin-stat-note">伺服器日期</div></div><div class="admin-stat"><div class="admin-stat-label">顯示範圍</div><div class="admin-stat-value"><%= records.length %></div><div class="admin-stat-note">最近 200 筆</div></div></section>
<section class="admin-panel"><div class="admin-panel-head"><div><h2>最近量測</h2><p>顯示最新記錄，可使用使用者篩選。</p></div></div><div class="admin-filter"><label for="recordUserFilter">使用者</label><select id="recordUserFilter"><option value="">所有使用者</option><% users.forEach(function(u) { %><option value="<%= u.id %>"><%= u.name %></option><% }); %></select></div><div class="admin-table-wrap"><table class="admin-record-table"><thead><tr><th>量測時間</th><th>使用者</th><th>收縮壓</th><th>舒張壓</th><th>心跳</th></tr></thead><tbody id="recordTableBody"><% records.forEach(function(r) { %><tr data-user-id="<%= r.user_id %>"><td><%= new Date(r.recorded_at).toLocaleString('zh-HK',{year:'numeric',month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'}) %></td><td><span class="admin-user"><span class="mini-avatar" style="background:<%= users.find(function(u){return u.id === r.user_id})?.color || '#667085' %>"><%= (r.user_name || '已移除使用者').charAt(0) %></span><%= r.user_name || '已移除使用者' %></span></td><td><%= r.high_pressure %> mmHg</td><td><%= r.low_pressure %> mmHg</td><td><%= r.heartbeat %> bpm</td></tr><% }); %></tbody></table><% if (!records.length) { %><div class="admin-empty">目前沒有血壓記錄</div><% } %></div></section>
<%- include('admin-end') %>
