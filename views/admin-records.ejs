<%- include('admin-start') %>
<section class="admin-summary-grid">
    <div class="admin-stat"><div class="admin-stat-label">全部記錄</div><div class="admin-stat-value"><%= summary.totalRecords.toLocaleString('zh-HK') %></div><div class="admin-stat-note">資料庫累計</div></div>
    <div class="admin-stat"><div class="admin-stat-label">今日記錄</div><div class="admin-stat-value"><%= summary.todayRecords.toLocaleString('zh-HK') %></div><div class="admin-stat-note">以伺服器日期計算</div></div>
    <div class="admin-stat"><div class="admin-stat-label">符合條件</div><div class="admin-stat-value"><%= recordsTotal.toLocaleString('zh-HK') %></div><div class="admin-stat-note">目前篩選結果</div></div>
</section>
<section class="admin-panel">
    <div class="admin-panel-head">
        <div><h2>最近量測</h2><p>條件會在伺服器端套用，匯出內容與目前篩選一致。</p></div>
        <a class="btn-sm btn-sm-edit" href="/admin/export/records.csv?<%= new URLSearchParams({user: recordFilters.userId, from: recordFilters.from, to: recordFilters.to, status: recordFilters.status, sort: recordFilters.sort}).toString() %>">匯出 CSV</a>
    </div>
    <form class="admin-filter admin-record-filters" method="get" action="/admin/records">
        <div class="admin-filter-field"><label for="recordUserFilter">使用者</label><select id="recordUserFilter" name="user"><option value="">所有使用者</option><% users.forEach(function(u) { %><option value="<%= u.id %>" <%= recordFilters.userId === String(u.id) ? 'selected' : '' %>><%= u.name %></option><% }); %></select></div>
        <div class="admin-filter-field"><label for="recordFromFilter">開始日期</label><input id="recordFromFilter" name="from" type="date" value="<%= recordFilters.from %>"></div>
        <div class="admin-filter-field"><label for="recordToFilter">結束日期</label><input id="recordToFilter" name="to" type="date" value="<%= recordFilters.to %>"></div>
        <div class="admin-filter-field"><label for="recordStatusFilter">血壓狀態</label><select id="recordStatusFilter" name="status"><option value="">全部狀態</option><option value="normal" <%= recordFilters.status === 'normal' ? 'selected' : '' %>>正常</option><option value="high" <%= recordFilters.status === 'high' ? 'selected' : '' %>>偏高</option><option value="low" <%= recordFilters.status === 'low' ? 'selected' : '' %>>偏低</option></select></div>
        <div class="admin-filter-field"><label for="recordSortFilter">排序</label><select id="recordSortFilter" name="sort"><option value="newest" <%= recordFilters.sort === 'newest' ? 'selected' : '' %>>最新在前</option><option value="oldest" <%= recordFilters.sort === 'oldest' ? 'selected' : '' %>>最早在前</option></select></div>
        <input type="hidden" name="pageSize" value="<%= recordsPageSize %>">
        <button type="submit" class="btn-sm btn-sm-edit">套用篩選</button>
        <a class="btn-sm btn-sm-reset" id="recordFilterReset" href="/admin/records">清除篩選</a>
    </form>
    <div class="admin-filter-summary" id="recordFilterSummary" role="status">第 <%= recordsTotal ? ((recordsPage - 1) * recordsPageSize + 1) : 0 %>-<%= Math.min(recordsPage * recordsPageSize, recordsTotal) %> 筆，共 <%= recordsTotal %> 筆</div>
    <div class="admin-table-wrap">
        <table class="admin-record-table"><thead><tr><th>量測時間</th><th>使用者</th><th>收縮壓</th><th>舒張壓</th><th>心跳</th></tr></thead><tbody id="recordTableBody">
        <% records.forEach(function(r) { const status = r.high_pressure >= 140 || r.low_pressure >= 90 ? 'high' : (r.high_pressure < 90 || r.low_pressure < 60 ? 'low' : 'normal'); %>
            <tr data-user-id="<%= r.user_id %>" data-recorded-at="<%= new Date(r.recorded_at).toISOString() %>" data-status="<%= status %>"><td><%= new Date(r.recorded_at).toLocaleString('zh-HK',{year:'numeric',month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'}) %></td><td><span class="admin-user"><span class="mini-avatar" style="background:<%= users.find(function(u){return u.id === r.user_id})?.color || '#667085' %>"><%= (r.user_name || '已移除使用者').charAt(0) %></span><%= r.user_name || '已移除使用者' %></span></td><td><%= r.high_pressure %> mmHg</td><td><%= r.low_pressure %> mmHg</td><td><%= r.heartbeat %> bpm</td></tr>
        <% }); %>
        </tbody></table>
        <div class="admin-empty" id="recordFilterEmpty" hidden>沒有符合條件的血壓記錄</div>
        <% if (!records.length) { %><div class="admin-empty">目前沒有符合條件的血壓記錄</div><% } %>
    </div>
    <% if (recordsTotal > recordsPageSize) { const totalPages = Math.ceil(recordsTotal / recordsPageSize); const pageUrl = function(page) { return '/admin/records?' + new URLSearchParams({user: recordFilters.userId, from: recordFilters.from, to: recordFilters.to, status: recordFilters.status, sort: recordFilters.sort, pageSize: recordsPageSize, page: page}).toString(); }; %>
        <nav class="admin-pagination" aria-label="血壓記錄分頁">
            <% if (recordsPage > 1) { %><a class="btn-sm btn-sm-reset admin-pagination-arrow" href="<%= pageUrl(recordsPage - 1) %>" aria-label="上一頁" title="上一頁">‹</a><% } %>
            <% paginationItems.forEach(function(item) { if (item === 'ellipsis') { %><span class="admin-pagination-gap" aria-hidden="true">…</span><% } else { %><a class="btn-sm <%= item === recordsPage ? 'btn-sm-edit' : 'btn-sm-reset' %>" href="<%= pageUrl(item) %>"<% if (item === recordsPage) { %> aria-current="page"<% } %>><%= item %></a><% } }); %>
            <% if (recordsPage < totalPages) { %><a class="btn-sm btn-sm-reset admin-pagination-arrow" href="<%= pageUrl(recordsPage + 1) %>" aria-label="下一頁" title="下一頁">›</a><% } %>
        </nav>
    <% } %>
</section>
<%- include('admin-end') %>
