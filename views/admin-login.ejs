<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>管理員登入<%= typeof titleSuffix !== 'undefined' && titleSuffix ? ' (' + titleSuffix + ')' : '' %></title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#16382a">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/admin-login.css">
</head>
<body class="admin-login-page">
    <main class="admin-login-shell">
        <section class="admin-login-intro" aria-labelledby="loginIntroTitle">
            <a class="admin-login-brand" href="/" aria-label="返回血壓記錄系統首頁">
                <span class="admin-login-mark"><img src="/favicon.ico" alt=""></span>
                <span>血壓記錄系統</span>
            </a>
            <div class="admin-login-intro-copy">
                <p class="admin-login-eyebrow">ADMINISTRATION</p>
                <h1 id="loginIntroTitle">安心管理每一筆健康資料</h1>
                <p>登入後台，集中查看使用者、量測記錄及資料備份。</p>
            </div>
            <div class="admin-login-intro-footer">管理後台 · 安全登入</div>
        </section>

        <section class="admin-login-panel" aria-labelledby="loginTitle">
            <div class="admin-login-panel-inner">
                <div class="admin-login-heading">
                    <p class="admin-login-panel-kicker">管理後台</p>
                    <h2 id="loginTitle">歡迎回來</h2>
                    <p>請輸入管理員帳號與密碼以繼續。</p>
                </div>
                <% if (typeof error !== 'undefined' && error) { %>
                <div class="login-error" role="alert">帳號或密碼不正確，請再試一次。</div>
                <% } %>
                <form class="admin-login-form" method="POST" action="/admin/login">
                    <div class="admin-login-field">
                        <label for="adminUsername">管理員帳號</label>
                        <input id="adminUsername" type="text" name="username" placeholder="輸入帳號" required autofocus autocomplete="username">
                    </div>
                    <div class="admin-login-field">
                        <label for="adminPassword">密碼</label>
                        <input id="adminPassword" type="password" name="password" placeholder="輸入密碼" required autocomplete="current-password">
                    </div>
                    <button type="submit" class="admin-login-submit">登入管理後台</button>
                </form>
                <a class="admin-login-back" href="/">返回首頁</a>
            </div>
        </section>
    </main>
</body>
</html>
