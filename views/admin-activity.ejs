<%- include('admin-start') %>
<section class="admin-panel"><h2>系統與資料狀態</h2><p>資料庫已連線 · 版本 v<%= appVersion %>。</p><p>血壓記錄 <%= Number(integrity.total || 0) %> 筆 · 無對應使用者 <%= Number(integrity.orphan_count || 0) %> 筆 · 數值範圍異常 <%= Number(integrity.invalid_count || 0) %> 筆</p></section>
<section class="admin-panel"><h2>外部資料庫備份狀態</h2><p>管理員回報，未自動驗證備份檔案。</p><% if (lastDatabaseSuccess) { %><p>最近回報成功：<strong><%= new Date(lastDatabaseSuccess.completed_at).toLocaleString('zh-HK') %></strong> · <%= lastDatabaseSuccess.source %></p><% } else { %><p>尚無成功回報，狀態未知。</p><% } %><% if (databaseBackups.length) { const latest = databaseBackups[0]; %><p>最近工作結果：<strong><%= latest.status === 'success' ? '成功' : '失敗' %></strong> · <%= new Date(latest.completed_at).toLocaleString('zh-HK') %> · <%= latest.source %></p><% } %>
<details class="admin-tool admin-disclosure admin-report-disclosure"><summary>登記備份結果</summary><form id="databaseBackupForm" class="admin-record-edit"><label for="databaseBackupSource">備份來源／工作名稱</label><input id="databaseBackupSource" maxlength="100" required placeholder="例如：NAS 每日 MariaDB 備份"><label for="databaseBackupTime">工作完成時間（裝置時區）</label><input id="databaseBackupTime" type="datetime-local" step="1" required><label for="databaseBackupStatus">工作結果</label><select id="databaseBackupStatus"><option value="success">成功</option><option value="failure">失敗</option></select><label for="databaseBackupReference">檔案或工作識別（成功時必填）</label><input id="databaseBackupReference" maxlength="250" required placeholder="例如：db-20261016.sql.gz"><label for="databaseBackupChecksum">SHA-256（選填）</label><input id="databaseBackupChecksum" maxlength="64" pattern="[a-fA-F0-9]{64}"><label for="databaseBackupNote">備註／失敗原因</label><textarea id="databaseBackupNote" maxlength="1000"></textarea><p>請勿填寫密碼或存取權杖。</p><button class="btn-sm btn-sm-edit" type="submit">保存備份回報</button><p id="databaseBackupResult" role="status" hidden></p></form></details>
<% databaseBackups.forEach(function(report) { %><article class="admin-tool"><strong><%= report.source %> · <%= report.status === 'success' ? '成功' : '失敗' %></strong><span>工作完成：<%= new Date(report.completed_at).toLocaleString('zh-HK') %> · 管理員回報：<%= report.actor %>（<%= new Date(report.created_at).toLocaleString('zh-HK') %>）</span><p><%= report.reference || '未提供檔案識別' %></p><% if (report.checksum) { %><code class="admin-checksum"><%= report.checksum %></code><% } %><p><%= report.note %></p></article><% }); %></section>
<section class="admin-panel"><h2>最近備份匯出</h2><p>僅記錄匯出，請確認檔案已保存。</p>
<% if (!backups.length) { %><div class="admin-empty">尚未有備份匯出紀錄</div><% } %>
<% backups.forEach(function(backup) { %><div class="admin-tool"><strong><%= new Date(backup.created_at).toLocaleString('zh-HK') %> · <%= backup.format.toUpperCase() %></strong><span><%= backup.actor %> · <%= backup.user_count %> 位使用者 · <%= backup.record_count %> 筆記錄</span><% if (backup.checksum) { %><code class="admin-checksum"><%= backup.checksum %></code><% } %></div><% }); %></section>
<section class="admin-panel"><h2>管理操作紀錄</h2><p>僅顯示啟用後的操作。</p>
<% if (!logs.length) { %><div class="admin-empty">尚未有操作紀錄</div><% } %>
<% const labels = { 'record.edit': '編輯記錄', 'record.delete': '刪除記錄', 'user.create': '新增使用者', 'user.edit': '編輯使用者', 'user.delete': '刪除使用者', 'backup.export': '匯出備份', 'backup.import': '匯入備份', 'records.export': '匯出 CSV', 'database-backup.report': '回報資料庫備份' }; logs.forEach(function(log) { %>
<article class="admin-tool"><strong><%= labels[log.action] || log.action %> · <%= log.status === 'success' ? '成功' : '失敗' %></strong><span><%= new Date(log.created_at).toLocaleString('zh-HK') %> · <%= log.actor %> · 對象 <%= log.target_id || '多筆／全體' %> · <%= log.affected_count %> 筆</span><details class="admin-disclosure admin-audit-disclosure"><summary>查看詳情</summary><pre class="admin-audit-details"><%= log.details %></pre></details></article><% }); %>
<nav class="admin-pagination" aria-label="操作紀錄分頁"><% if (page > 1) { %><a class="btn-sm btn-sm-reset" href="?page=<%= page - 1 %>">上一頁</a><% } %><span>第 <%= page %> 頁</span><% if (hasNext) { %><a class="btn-sm btn-sm-reset" href="?page=<%= page + 1 %>">下一頁</a><% } %></nav></section>
<%- include('admin-end') %>
