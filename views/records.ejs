<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>血壓記錄<%= typeof userName !== 'undefined' && userName ? ' (' + userName + ')' : '' %><%= typeof titleSuffix !== 'undefined' && titleSuffix && !userName ? ' (' + titleSuffix + ')' : '' %></title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2d6a4f">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <!-- 頂部導航 -->
        <div class="top-nav has-tools center-title">
            <a href="/bp/<%= userId %>?name=<%= encodeURIComponent(typeof userName !== 'undefined' ? userName : '') %>" class="nav-btn"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg> 返回</a>
            <h1>血壓記錄<%= typeof userName !== 'undefined' && userName ? ' (' + userName + ')' : '' %></h1>
            <a href="/export/excel?userId=<%= userId %>&name=<%= encodeURIComponent(typeof userName !== 'undefined' ? userName : '') %>" class="nav-btn" style="font-size:15px;"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> 匯出</a>
        </div>

        <!-- 統計按鈕：獨立一行，橫跨整行 -->
        <a href="/stats?userId=<%= userId %>&name=<%= encodeURIComponent(typeof userName !== 'undefined' ? userName : '') %>" class="nav-btn stats-nav-btn"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg> 統計</a>

        <%
            var userId = typeof userId !== 'undefined' ? userId : 1;
            var months = Object.keys(groupedRecords).sort();
            var currentIdx = months.indexOf(selectedMonth);
            if (currentIdx === -1) currentIdx = months.length - 1;
            var currentMonth = months.length > 0 ? months[currentIdx] : null;
            var prevMonth = currentIdx > 0 ? months[currentIdx - 1] : null;
            var nextMonth = currentIdx < months.length - 1 ? months[currentIdx + 1] : null;

            function formatMonth(ym) {
                return ym ? ym.replace('-', '年') + '月' : '';
            }
        %>

        <% if (currentMonth) { %>
        <!-- 月份導航 -->
        <div class="month-nav">
            <% if (prevMonth) { %>
                <a href="/records?yearMonth=<%= prevMonth %>&userId=<%= userId %>&name=<%= encodeURIComponent(typeof userName !== 'undefined' ? userName : '') %>" class="arrow-btn">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                </a>
            <% } else { %>
                <span class="arrow-btn" style="visibility:hidden;">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                </span>
            <% } %>
            <select class="month-select" onchange="location=this.value">
                <% months.forEach(function(m) { %>
                    <option value="/records?yearMonth=<%= m %>&userId=<%= userId %>&name=<%= encodeURIComponent(typeof userName !== 'undefined' ? userName : '') %>" <%= m === currentMonth ? 'selected' : '' %>><%= formatMonth(m) %></option>
                <% }); %>
            </select>
            <% if (nextMonth) { %>
                <a href="/records?yearMonth=<%= nextMonth %>&userId=<%= userId %>&name=<%= encodeURIComponent(typeof userName !== 'undefined' ? userName : '') %>" class="arrow-btn">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
            <% } else { %>
                <span class="arrow-btn" style="visibility:hidden;">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </span>
            <% } %>
        </div>

        <%
            // Build day map: day -> {早: record, 晚: record}
            var dayMap = {};
            (groupedRecords[currentMonth] || []).forEach(function(r) {
                var d = new Date(r.recorded_at);
                var day = d.getDate();
                var period = d.getHours() < 12 ? '早' : '晚';
                if (!dayMap[day]) dayMap[day] = {};
                dayMap[day][period] = r;
            });

            var ymParts = currentMonth.split('-');
            var year = parseInt(ymParts[0]);
            var month = parseInt(ymParts[1]);
            var firstWeekday = new Date(year, month - 1, 1).getDay();
            var daysInMonth = new Date(year, month, 0).getDate();
            var weekdayNames = ['日', '一', '二', '三', '四', '五', '六'];

            function dayStatus(day) {
                var d = dayMap[day];
                if (!d) return '';
                var worst = 0;
                ['早', '晚'].forEach(function(p) {
                    if (d[p]) {
                        var hp = parseInt(d[p].high_pressure);
                        var lp = parseInt(d[p].low_pressure);
                        var s = (hp >= 140 || lp >= 90) ? 2 : ((hp < 90 || lp < 60) ? 1 : 0);
                        if (s > worst) worst = s;
                    }
                });
                return worst === 2 ? 'high' : (worst === 1 ? 'low' : 'normal');
            }

            function periodStatus(record) {
                if (!record) return 'empty';
                var hp = parseInt(record.high_pressure);
                var lp = parseInt(record.low_pressure);
                if (hp >= 140 || lp >= 90) return 'high';
                if (hp < 90 || lp < 60) return 'low';
                return 'normal';
            }

            function bpClass(record) {
                var hp = parseInt(record.high_pressure);
                var lp = parseInt(record.low_pressure);
                if (hp >= 140 || lp >= 90) return 'bp-high-border';
                if (hp < 90 || lp < 60) return 'bp-low-border';
                return 'bp-normal-border';
            }
        %>

        <!-- 月曆 -->
        <div class="calendar-legend" aria-label="月曆狀態圖例">
            <span><b>早</b> 上午</span>
            <span><b>晚</b> 晚上</span>
            <span><b class="legend-state-done">✓</b> 已記錄</span>
            <span><b class="legend-state-missing">—</b> 未記錄</span>
        </div>
        <div class="calendar">
            <div class="cal-weekdays">
                <% weekdayNames.forEach(function(w) { %><span class="cal-wd"><%= w %></span><% }); %>
            </div>
            <div class="cal-grid">
                <% for (var i = 0; i < firstWeekday; i++) { %><span class="cal-blank"></span><% } %>
                <% for (var day = 1; day <= daysInMonth; day++) { %>
                    <% var wd = new Date(year, month - 1, day).getDay(); %>
                    <a href="/records/day?date=<%= year %>-<%= String(month).padStart(2, '0') %>-<%= String(day).padStart(2, '0') %>&userId=<%= userId %>&name=<%= encodeURIComponent(typeof userName !== 'undefined' ? userName : '') %>"
                       class="cal-cell <%= dayStatus(day) %> period-am-<%= periodStatus(dayMap[day] && dayMap[day]['早']) %> period-pm-<%= periodStatus(dayMap[day] && dayMap[day]['晚']) %> <%= wd === 0 ? 'sun' : (wd === 6 ? 'sat' : '') %>">
                        <span class="cal-daynum"><%= day %></span>
                        <span class="cal-periods" aria-label="<%= dayMap[day] && dayMap[day]['早'] ? '早上已記錄' : '早上未記錄' %>，<%= dayMap[day] && dayMap[day]['晚'] ? '晚上已記錄' : '晚上未記錄' %>">
                            <span class="period-marker period-am-<%= periodStatus(dayMap[day] && dayMap[day]['早']) %>"><span class="period-label">早</span><span class="period-state"><%= dayMap[day] && dayMap[day]['早'] ? '✓' : '—' %></span></span>
                            <span class="period-marker period-pm-<%= periodStatus(dayMap[day] && dayMap[day]['晚']) %>"><span class="period-label">晚</span><span class="period-state"><%= dayMap[day] && dayMap[day]['晚'] ? '✓' : '—' %></span></span>
                        </span>
                    </a>
                <% } %>
            </div>
        </div>

        <% } else { %>
            <div class="empty-state">沒有記錄</div>
        <% } %>
    </div>
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js');
        }
    </script>
</body>
</html>
