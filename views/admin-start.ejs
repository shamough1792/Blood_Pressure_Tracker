<!DOCTYPE html>
<html lang="zh-HK"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="csrf-token" content="<%= csrfToken %>"><title><%= pageTitle %>｜管理後台<%= titleSuffix ? ' (' + titleSuffix + ')' : '' %></title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/admin.css?v=<%= encodeURIComponent(appVersion) %>"></head><body class="admin-body">
<div class="admin-shell"><aside class="admin-sidebar"><a class="admin-brand" href="/admin"><span class="admin-brand-mark"><img src="/favicon.ico" alt=""></span><span><strong>血壓管理系統</strong><small>Administration</small></span></a><nav class="admin-nav" aria-label="管理導覽">
<a class="<%= activePage === 'overview' ? 'active' : '' %>" href="/admin"><span aria-hidden="true">▦</span>總覽</a><a class="<%= activePage === 'users' ? 'active' : '' %>" href="/admin/users"><span aria-hidden="true">♙</span>使用者</a><a class="<%= activePage === 'records' ? 'active' : '' %>" href="/admin/records"><span aria-hidden="true">◷</span>血壓記錄</a><a class="<%= activePage === 'backup' ? 'active' : '' %>" href="/admin/backup"><span aria-hidden="true">▣</span>備份還原</a></nav><div class="admin-sidebar-footer">管理後台<br>版本 v<%= appVersion %></div></aside>
<main class="admin-main"><div class="admin-main-inner"><header class="admin-topbar"><div><div class="admin-kicker">ADMINISTRATION</div><h1 class="admin-title"><%= pageTitle %></h1><p class="admin-subtitle"><%= pageDescription %></p></div><div class="admin-top-actions"><a href="/" class="nav-btn">返回首頁</a><form method="POST" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn-sm btn-sm-delete">登出</button></form></div></header>
