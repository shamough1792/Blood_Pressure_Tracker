<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>血壓紀錄管理系統<%= typeof titleSuffix !== 'undefined' && titleSuffix ? ' (' + titleSuffix + ')' : '' %></title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2d6a4f">
    <link rel="stylesheet" href="/styles.css">
    <style>
        body{background:#f0f4f8;min-height:100vh}
        .portal-wrap{width:100%;max-width:560px;margin:0 auto;padding:20px 16px 96px;min-height:100vh;display:flex;flex-direction:column}
        .portal-header{background:#2d6a4f;color:#fff;border-radius:16px;padding:28px;text-align:center;margin-bottom:24px;box-shadow:0 6px 18px rgba(45,106,79,0.2)}
        .portal-header h1{font-size:30px;font-weight:700;margin-bottom:6px;color:#fff}
        .portal-header p{font-size:17px;opacity:.85;margin:0}
        .user-grid{display:flex;justify-content:center}
        .user-options{display:flex;flex-wrap:wrap;gap:16px;justify-content:center;width:100%}
        .user-card{display:flex;flex-direction:column;align-items:center;text-decoration:none;width:144px;min-height:166px;padding:20px 16px 18px;border-radius:12px;background:#fff;border:2px solid transparent;box-shadow:0 3px 12px rgba(0,0,0,0.08);transition:all .2s ease;cursor:pointer}
        .user-card:hover,.user-card:focus-visible{transform:translateY(-3px);border-color:#2d6a4f;box-shadow:0 8px 18px rgba(45,106,79,0.18);outline:none}
        .user-avatar{width:88px;height:88px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:38px;color:#fff;margin-bottom:14px;box-shadow:0 6px 16px rgba(0,0,0,0.18);transition:transform .25s ease;font-weight:600}
        .user-card:hover .user-avatar{transform:scale(1.04)}
        .user-name{font-size:22px;font-weight:700;color:#1a1a2e}
        .user-card-hint{font-size:14px;color:#52616b;margin-top:6px}
        .admin-link{position:fixed;bottom:24px;right:24px;width:52px;height:52px;border-radius:50%;background:#2d6a4f;color:#fff;border:none;font-size:24px;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(45,106,79,0.3);text-decoration:none;z-index:10;transition:transform .2s}
        .admin-link:hover{transform:scale(1.1)}
        @media(max-width:480px){.portal-header{padding:20px 16px}.portal-header h1{font-size:24px}.user-card{width:calc(50% - 8px);min-width:130px;padding:16px 12px}.user-avatar{width:72px;height:72px;font-size:32px}.user-name{font-size:19px}}
    </style>
</head>
<body>
    <div class="portal-wrap">
        <div class="portal-header">
            <h1><svg class="icon icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-5px;"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg> 血壓紀錄管理系統</h1>
            <p>選擇要記錄的家人</p>
        </div>

        <div class="user-grid">
            <% if (users && users.length > 0) { %>
            <div class="user-options">
            <% users.forEach(function(u) { %>
                <a href="/bp/<%= u.id %>?name=<%= encodeURIComponent(u.name) %>" class="user-card" aria-label="為 <%= u.name %> 新增血壓紀錄" onclick="localStorage.setItem('bp_user', '<%= u.id %>')">
                    <div class="user-avatar" style="background:<%= u.color %>">
                        <%= u.name.charAt(0) %>
                    </div>
                    <span class="user-name"><%= u.name %></span>
                    <span class="user-card-hint">開始記錄</span>
                </a>
            <% }); %>
            </div>
            <% } else { %>
            <p style="text-align:center;font-size:20px;color:#999;">尚未建立使用者，請點右下角齒輪按鈕新增</p>
            <% } %>
        </div>
    </div>

    <a href="/admin" class="admin-link" title="管理"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:26px;height:26px;"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></a>

    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js');
        }
    </script>
</body>
</html>
