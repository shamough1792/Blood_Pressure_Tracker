<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>修改血壓記錄<%= typeof titleSuffix !== 'undefined' && titleSuffix ? ' (' + titleSuffix + ')' : '' %></title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2d6a4f">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <div class="top-nav center-title">
            <a href="/records?userId=<%= typeof userId !== 'undefined' ? userId : 1 %>&name=<%= typeof userName !== 'undefined' ? encodeURIComponent(userName) : '' %>" class="nav-btn"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg> 返回記錄</a>
            <h1>修改記錄<%= typeof titleSuffix !== 'undefined' && titleSuffix ? ' (' + titleSuffix + ')' : '' %></h1>
            <span style="width:60px;"></span>
        </div>

        <div class="form-page">
            <form action="/update/<%= record.id %>" method="POST" novalidate><input type="hidden" name="userId" value="<%= typeof userId !== 'undefined' ? userId : 1 %>"><input type="hidden" name="name" value="<%= typeof userName !== 'undefined' ? userName : '' %>"><input type="hidden" name="_actionToken" value="<%= typeof actionToken !== 'undefined' ? actionToken : '' %>">
                <div class="form-group" data-field="high_pressure">
                    <label for="high_pressure">高壓</label>
                    <input type="number" id="high_pressure" name="high_pressure"
                           value="<%= record.high_pressure %>" required min="50" max="250">
                    <div class="field-error" id="highPressureError" role="alert" aria-live="polite"></div>
                </div>

                <div class="form-group" data-field="low_pressure">
                    <label for="low_pressure">低壓</label>
                    <input type="number" id="low_pressure" name="low_pressure"
                           value="<%= record.low_pressure %>" required min="30" max="150">
                    <div class="field-error" id="lowPressureError" role="alert" aria-live="polite"></div>
                </div>

                <div class="form-group" data-field="heartbeat">
                    <label for="heartbeat">心跳</label>
                    <input type="number" id="heartbeat" name="heartbeat"
                           value="<%= record.heartbeat %>" required min="30" max="200">
                    <div class="field-error" id="heartbeatError" role="alert" aria-live="polite"></div>
                </div>

                <div class="form-group">
                    <label for="time_of_day">時段</label>
                    <select id="time_of_day" name="time_of_day" required>
                        <option value="AM" <%= new Date(record.recorded_at).getHours() < 12 ? 'selected' : '' %>>上午</option>
                        <option value="PM" <%= new Date(record.recorded_at).getHours() >= 12 ? 'selected' : '' %>>下午</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="record_date">日期</label>
                    <input type="date" id="record_date" name="record_date"
                           value="<%= new Date(record.recorded_at).toISOString().split('T')[0] %>" required>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> 儲存修改</button>
                    <a href="/records?userId=<%= typeof userId !== 'undefined' ? userId : 1 %>&name=<%= typeof userName !== 'undefined' ? encodeURIComponent(userName) : '' %>" class="btn btn-back">取消</a>
                </div>
            </form>
        </div>
    </div>
    <script>
        (function () {
            const form = document.querySelector('form[novalidate]');
            const fields = [
                { id: 'high_pressure', error: 'highPressureError', name: '高壓', min: 50, max: 250 },
                { id: 'low_pressure', error: 'lowPressureError', name: '低壓', min: 30, max: 150 },
                { id: 'heartbeat', error: 'heartbeatError', name: '心跳', min: 30, max: 200 }
            ];
            function showModifyError(field, message) {
                const input = document.getElementById(field.id);
                const group = input.closest('.form-group');
                input.classList.toggle('form-control-error', Boolean(message));
                group.classList.toggle('form-group-error', Boolean(message));
                document.getElementById(field.error).textContent = message || '';
            }
            function validate() {
                let valid = true;
                fields.forEach(function (field) {
                    const value = Number(document.getElementById(field.id).value);
                    let message = '';
                    if (!Number.isInteger(value)) message = '請輸入' + field.name;
                    else if (value < field.min || value > field.max) message = field.name + '範圍應在 ' + field.min + ' ~ ' + field.max + ' 之間';
                    showModifyError(field, message);
                    if (message) valid = false;
                });
                const high = Number(document.getElementById('high_pressure').value);
                const low = Number(document.getElementById('low_pressure').value);
                if (valid && low >= high) {
                    showModifyError(fields[1], '低壓不能大於或等於高壓');
                    valid = false;
                }
                return valid;
            }
            fields.forEach(function (field) {
                document.getElementById(field.id).addEventListener('input', function () { showModifyError(field, ''); });
            });
            form.addEventListener('submit', function (event) {
                if (!validate()) event.preventDefault();
            });
            window.showModifyError = showModifyError;
        }());
    </script>
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js');
        }
    </script>
</body>
</html>
