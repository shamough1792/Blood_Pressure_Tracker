<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>統計<%= typeof userName !== 'undefined' && userName ? ' (' + userName + ')' : '' %><%= typeof titleSuffix !== 'undefined' && titleSuffix && !userName ? ' (' + titleSuffix + ')' : '' %></title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2d6a4f">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="stylesheet" href="/styles.css">
    <script src="/chart.umd.min.js"></script>
</head>
<body>
    <div class="container">
        <div class="top-nav">
            <a href="/records?userId=<%= userId %>&name=<%= encodeURIComponent(typeof userName !== 'undefined' ? userName : '') %>" class="nav-btn">← 返回</a>
            <h1>統計<%= typeof userName !== 'undefined' && userName ? ' (' + userName + ')' : '' %></h1>
            <span style="width:60px;"></span>
        </div>

        <!-- 時間範圍 -->
        <div class="range-nav">
            <% [1, 3, 6, 12, 0].forEach(function(r) { %>
                <a href="/stats?userId=<%= userId %>&name=<%= encodeURIComponent(typeof userName !== 'undefined' ? userName : '') %>&range=<%= r %>"
                   class="range-btn <%= r === range ? 'selected' : '' %>"><%= r === 0 ? '全部' : r + '個月' %></a>
            <% }); %>
        </div>

        <% if (stats.total > 0) { %>
        <!-- 摘要 -->
        <div class="stat-cards">
            <div class="stat-card">
                <div class="stat-label">平均高壓</div>
                <div class="stat-value val-sys"><%= stats.avgHigh %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">平均低壓</div>
                <div class="stat-value val-dia"><%= stats.avgLow %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">平均心跳</div>
                <div class="stat-value val-heart"><%= stats.avgHeart %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">正常率</div>
                <div class="stat-value" style="background:#e8f5e9;color:#2d6a4f;"><%= stats.normalRate %>%</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">高血壓次數</div>
                <div class="stat-value" style="background:#ffebee;color:#c62828;"><%= stats.highCount %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">低血壓次數</div>
                <div class="stat-value" style="background:#e3f2fd;color:#1565c0;"><%= stats.lowCount %></div>
            </div>
        </div>
        <p class="stat-total">共 <%= stats.total %> 次記錄（<%= range === 0 ? '全部' : '最近 ' + range + ' 個月' %>）</p>

        <!-- 趨勢圖：血壓 -->
        <div class="chart-card">
            <h3>血壓趨勢</h3>
            <div class="chart-wrap"><canvas id="bpChart"></canvas></div>
        </div>

        <!-- 趨勢圖：心跳 -->
        <div class="chart-card">
            <h3>心跳趨勢</h3>
            <div class="chart-wrap"><canvas id="heartChart"></canvas></div>
        </div>

        <!-- 放大檢視 -->
        <div id="zoomOverlay" class="zoom-overlay" onclick="if (event.target === this) closeZoom()">
            <div class="zoom-box">
                <button class="zoom-close" onclick="closeZoom()">✕</button>
                <h3 id="zoomTitle"></h3>
                <div class="zoom-wrap"><canvas id="zoomChart"></canvas></div>
            </div>
        </div>

        <script>
            var data = <%- JSON.stringify(chartData) %>;
            var bpDatasets = [
                { label: '高壓', data: data.map(function(d) { return d.high; }), borderColor: '#e53935', backgroundColor: 'rgba(229,57,53,0.08)', tension: 0.3, pointRadius: 2, borderWidth: 2 },
                { label: '低壓', data: data.map(function(d) { return d.low; }), borderColor: '#1e88e5', backgroundColor: 'rgba(30,136,229,0.08)', tension: 0.3, pointRadius: 2, borderWidth: 2 }
            ];
            var heartDatasets = [
                { label: '心跳', data: data.map(function(d) { return d.heart; }), borderColor: '#f9a825', backgroundColor: 'rgba(249,168,37,0.08)', tension: 0.3, pointRadius: 2, borderWidth: 2 }
            ];

            function makeChart(id, datasets) {
                return new Chart(document.getElementById(id).getContext('2d'), {
                    type: 'line',
                    data: { labels: data.map(function(d) { return d.label; }), datasets: datasets },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: { legend: { labels: { font: { size: 13 }, boxWidth: 20 } } },
                        scales: {
                            y: { beginAtZero: false, ticks: { font: { size: 11 } } },
                            x: { ticks: { maxTicksLimit: 7, font: { size: 10 } } }
                        }
                    }
                });
            }

            makeChart('bpChart', bpDatasets);
            makeChart('heartChart', heartDatasets);

            // 點擊圖表放大
            var zoomChartInst = null;
            function openZoom(title, datasets) {
                document.getElementById('zoomTitle').textContent = title;
                document.getElementById('zoomOverlay').style.display = 'flex';
                zoomChartInst = makeChart('zoomChart', datasets);
            }
            function closeZoom() {
                document.getElementById('zoomOverlay').style.display = 'none';
                if (zoomChartInst) { zoomChartInst.destroy(); zoomChartInst = null; }
            }
            document.getElementById('bpChart').addEventListener('click', function() { openZoom('血壓趨勢', bpDatasets); });
            document.getElementById('heartChart').addEventListener('click', function() { openZoom('心跳趨勢', heartDatasets); });
        </script>
        <% } else { %>
            <div class="empty-state">所選範圍內沒有記錄</div>
        <% } %>
    </div>
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js');
        }
    </script>
</body>
</html>
